modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["cargo", "libiconv", "libxcrypt", "openssl", "pkg-config", "rustc", "chromium"]

[userenv]

[userenv.shared]
CPTR_FLOWDECK_COORDINATOR_ENABLED = "true"
CPTR_FLOWDECK_ENABLED = "true"
CPTR_FLOWDECK_GOVERNANCE = "strict"
CPTR_FLOWDECK_MODE = "controlled"
