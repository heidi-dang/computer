modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "flowdeck-terminal-regression"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "computer-frontend-check"

[[workflows.workflow]]
name = "flowdeck-terminal-regression"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/computer && pytest -q tests/test_flowdeck_agent_terminal.py tests/test_flowdeck.py tests/test_flowdeck_coding.py tests/test_flowdeck_execution.py tests/test_flowdeck_native_transcript_contract.py"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "computer-frontend-check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/computer/cptr/frontend && npm run check"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["cargo", "chromium", "libiconv", "libxcrypt", "openssl", "pkg-config", "postgresql", "rustc", "glib", "nspr", "nss", "atk", "at-spi2-atk", "cups", "libdrm", "libgbm", "libxkbcommon", "pango", "cairo", "alsa-lib", "mesa", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "libglvnd"]

[userenv]

[userenv.shared]
CPTR_FLOWDECK_COORDINATOR_ENABLED = "true"
CPTR_FLOWDECK_ENABLED = "true"
CPTR_FLOWDECK_GOVERNANCE = "strict"
CPTR_FLOWDECK_MODE = "controlled"
CPTR_FLOWDECK_MUTATING_AGENTS = "true"
CPTR_FLOWDECK_AGENT_TERMINAL_ENABLED = "true"

[[ports]]
localPort = 4175
externalPort = 3001
exposeLocalhost = true

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 21823
externalPort = 3000
